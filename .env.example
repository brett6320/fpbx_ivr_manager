# ---- Web server ----
APP_SECRET_KEY=change-me-to-a-long-random-string
APP_BASE_URL=https://ivr.example.com
APP_ORG_NAME=Acme Corporation
# Admin-managed business profile (name + business-hours templates), referenced in
# prompts via placeholders like {business_name} and {greeting}. App-writable.
BUSINESS_CONFIG_FILE=data/business.json

# Session cookie Secure flag. Empty = derive from APP_BASE_URL (https -> Secure).
# The Secure cookie is NOT sent over plain HTTP, so if you access the app over
# http:// you'll be redirected back to login forever — set this to false for HTTP.
SESSION_HTTPS_ONLY=
# Dev mode: relaxes security for local development — does NOT force MFA enrollment
# for local admins. Never enable in production.
DEV_MODE=false

# ---- Auth backend: local (default) | entra | ldap | fpbx ----
# fpbx authenticates against the FusionPBX user DB (needs: pip install '.[fpbx]');
# see docs/fpbx-auth.md
AUTH_BACKEND=local

# ---- Local auth (default backend) ----
LOCAL_AUTH_DB=data/users.db
# Seeded on first startup only if the user table is empty (admin flag set):
LOCAL_ADMIN_USER=admin@local
LOCAL_ADMIN_PASSWORD=change-me
# Membership in this group also designates a user as a local admin (MFA required).
# Keep it distinct from permission groups if you don't want perms to imply admin.
LOCAL_ADMIN_GROUP=ivr-admins

# ---- MFA for local admins (passkey or TOTP; see docs/mfa.md) ----
# Local admins ALWAYS require MFA, even under an external IdP. Break-glass local
# admin login is always available at /auth/local.
# Passkeys need the extra: pip install '.[passkey]'. WebAuthn RP id/origin are
# derived from APP_BASE_URL (serve over HTTPS on a stable hostname).

# ---- Entra ID (Azure AD) SSO — only when AUTH_BACKEND=entra ----
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Redirect URI registered in the app registration = {APP_BASE_URL}/auth/callback

# ---- LDAP — only when AUTH_BACKEND=ldap (needs: pip install '.[ldap]') ----
LDAP_URI=ldaps://ldap.example.com
LDAP_BIND_DN_TEMPLATE=uid={username},ou=people,dc=example,dc=com
LDAP_BASE_DN=ou=people,dc=example,dc=com
LDAP_USER_FILTER=(uid={username})
LDAP_GROUP_BASE_DN=ou=groups,dc=example,dc=com
LDAP_GROUP_FILTER=(member={user_dn})
LDAP_START_TLS=true

# ---- Authorization: permissions bound to GROUPS ONLY (never to users) ----
# JSON: group identifier -> permissions. Group id = group name (local),
# object-id/name in token 'groups' claim (entra), or group cn (ldap).
# Permissions: manage_closures, manage_users
AUTHZ_GROUP_PERMISSIONS={"ivr-admins":["manage_closures","manage_users"],"ivr-editors":["manage_closures"]}

# ---- FusionPBX PostgreSQL (co-located = localhost) ----
FPBX_DB_HOST=127.0.0.1
FPBX_DB_PORT=5432
FPBX_DB_NAME=fusionpbx
FPBX_DB_USER=fusionpbx
FPBX_DB_PASSWORD=your-db-password
# The FusionPBX domain (tenant) these IVRs belong to
FPBX_DOMAIN_NAME=pbx.example.com

# Startup FusionPBX schema-capability check (supports 4.5.x through 5.5):
#   warn (default) | strict (fail boot on missing/unsupported schema) | off
FPBX_SCHEMA_CHECK=warn

# ---- FreeSWITCH mod_xml_rpc (reloadxml, localhost) ----
FS_XMLRPC_URL=http://127.0.0.1:8787/RPC2
FS_XMLRPC_USER=freeswitch
FS_XMLRPC_PASSWORD=works

# ---- Recording storage (co-located: write local FS) ----
# storage = local | db | sftp
#   local: write the wav straight into the FS recordings dir (app runs on PBX host)
#   db:    store base64 in v_recordings (FusionPBX must be set to db storage)
#   sftp:  remote push (only if NOT co-located; needs the 'remote' extra)
FPBX_RECORDING_STORAGE=local
# FusionPBX per-domain recordings dir (must be writable by the app's user/group)
FS_RECORDINGS_DIR=/var/lib/freeswitch/storage/${FPBX_DOMAIN_NAME}/recordings

# ---- SFTP (only when FPBX_RECORDING_STORAGE=sftp) ----
FS_SSH_HOST=
FS_SSH_PORT=22
FS_SSH_USER=root
FS_SSH_KEY_PATH=

# ---- Google Cloud Text-to-Speech (service account) ----
# Path to a Google service-account JSON with the Cloud Text-to-Speech role.
GOOGLE_TTS_CREDENTIALS_FILE=/etc/fpbx-ivr-manager/google-tts.json
GOOGLE_TTS_VOICE=en-US-Neural2-C
GOOGLE_TTS_LANGUAGE=en-US

# ---- Extension pool for managed closure IVRs ----
EXT_POOL_START=9550
EXT_POOL_END=9599

# Sample EnvironmentFile for the native systemd deployment.
#
#   sudo install -d -m 750 -o root -g ivrmgr /etc/fpbx-ivr-manager
#   sudo cp deploy/fpbx-ivr-manager.env.sample /etc/fpbx-ivr-manager/env
#   sudo chown root:ivrmgr /etc/fpbx-ivr-manager/env && sudo chmod 640 /etc/fpbx-ivr-manager/env
#
# The unit references this via EnvironmentFile=/etc/fpbx-ivr-manager/env.
# Generate APP_SECRET_KEY with: python -c 'import secrets;print(secrets.token_urlsafe(48))'

# ---- web ----
APP_SECRET_KEY=REPLACE_WITH_LONG_RANDOM
APP_BASE_URL=https://ivr.example.com
APP_ORG_NAME=Acme Corporation
# Business profile store (name + business-hours templates); app-writable JSON.
BUSINESS_CONFIG_FILE=/var/lib/fpbx-ivr-manager/business.json


# ---- auth backend: local (default) | entra | ldap ----
AUTH_BACKEND=local
# local users DB lives under the systemd StateDirectory (0700, owned by ivrmgr):
LOCAL_AUTH_DB=/var/lib/fpbx-ivr-manager/users.db
# App-writable auth override file, managed by the admin UI (/admin/auth). Also in
# the StateDirectory so the app can write it without touching the root-owned env.
AUTH_CONFIG_FILE=/var/lib/fpbx-ivr-manager/auth.env
LOCAL_ADMIN_USER=admin
LOCAL_ADMIN_PASSWORD=REPLACE_ME
LOCAL_ADMIN_GROUP=ivr-admins
# Permissions are bound to groups only:
AUTHZ_GROUP_PERMISSIONS={"ivr-admins":["manage_closures","manage_users"],"ivr-editors":["manage_closures"]}

# ---- FusionPBX PostgreSQL (localhost; use the scoped role, not the fusionpbx owner) ----
FPBX_DB_HOST=127.0.0.1
FPBX_DB_PORT=5432
FPBX_DB_NAME=fusionpbx
FPBX_DB_USER=ivr_manager
FPBX_DB_PASSWORD=REPLACE_ME
FPBX_DOMAIN_NAME=pbx.example.com

# ---- FreeSWITCH mod_xml_rpc (localhost) ----
FS_XMLRPC_URL=http://127.0.0.1:8787/RPC2
FS_XMLRPC_USER=freeswitch
FS_XMLRPC_PASSWORD=REPLACE_ME

# ---- recording storage: db (no filesystem access) recommended ----
FPBX_RECORDING_STORAGE=db
# For 'local' instead: put ivrmgr in the freeswitch group (see sysusers) and set
# FS_RECORDINGS_DIR + add ReadWritePaths to the unit.
# FS_RECORDINGS_DIR=/var/lib/freeswitch/storage/${FPBX_DOMAIN_NAME}/recordings

# ---- Google TTS (service account) ----
# Service-account JSON (chmod 600, readable by the service user). Grant it only
# the Cloud Text-to-Speech role.
GOOGLE_TTS_CREDENTIALS_FILE=/etc/fpbx-ivr-manager/google-tts.json
GOOGLE_TTS_VOICE=en-US-Neural2-C
GOOGLE_TTS_LANGUAGE=en-US

# ---- extension pool ----
EXT_POOL_START=9550
EXT_POOL_END=9599
